{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "ignorePatterns": [
    "dist/",
    "src/content/posts/*.mdx",
    "src/content/bibliography/",
    "src/styles/global.css",
    "public/"
  ],
  "overrides": [
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
