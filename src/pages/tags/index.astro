---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/get-posts';
import { tagIndex } from '../../lib/posts';

const tags = [...tagIndex(await getPosts()).entries()]
  .map(([slug, { name, posts }]) => ({ slug, name, count: posts.length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout title="Tags" currentPath="/tags/">
  <div class="content-container">
    <h1 class="index-title">Tags</h1>
    <ul class="tag-list">
      {tags.map((tag) => (
        <li><a href={`/tags/${tag.slug}/`}>{tag.name} ({tag.count})</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
