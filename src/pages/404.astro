---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you asked for does not exist." currentPath="/404">
  <div class="content-container not-found">
    <div class="index-header">
      <h1 class="index-title">404</h1>
      <p class="index-subtitle">페이지를 찾을 수 없습니다</p>
    </div>
    <p>주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <p><a href="/">홈으로 돌아가기</a></p>
  </div>
</BaseLayout>
