---
// Meta line above the post title: `date · 수정 <lastmod> · N분`.
import { siteConfig } from '../config';

interface Props {
  date: Date;
  lastmod: Date | null;
  minutes: number;
}

const { date, lastmod, minutes } = Astro.props;

// en-CA formats as YYYY-MM-DD.
const seoulDate = new Intl.DateTimeFormat('en-CA', {
  timeZone: siteConfig.timezone,
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const published = seoulDate.format(date);
// Show the edit date only when it falls on a later day than the publish date.
const modified = lastmod ? seoulDate.format(lastmod) : null;
const showModified = modified !== null && modified !== published;
---

<span class="article-meta">
  <time datetime={date.toISOString()}>{published}</time>
  {
    showModified && (
      <>
        {' · 수정 '}
        <time datetime={lastmod!.toISOString()}>{modified}</time>
      </>
    )
  }
  {` · ${minutes}분`}
</span>
