---
// A figure shown one frame at a time, for diagrams whose point is a change of state.
// Frames are light/dark SVG pairs named `${base}-s${n}-light.svg` and `${base}-s${n}-dark.svg`
// (n starts at 1). Without JavaScript only the first frame shows; the script adds the controls.
interface Props {
  /** Path prefix of the frame files, e.g. `/assets/images/post/x/figure`. */
  base: string;
  /** One short description per frame, in order. The number of labels sets the number of frames. */
  labels: string[];
  caption?: string;
}

const { base, labels, caption } = Astro.props;
const frames = labels.map((label, i) => ({
  label,
  light: `${base}-s${i + 1}-light.svg`,
  dark: `${base}-s${i + 1}-dark.svg`,
}));
const alt = (label: string) => (caption ? `${caption} ${label}` : label);
---

<figure class="figure figure-steps" data-figure-steps data-labels={JSON.stringify(labels)}>
  <div class="fs-stage">
    {
      frames.map((f, i) => (
        <div class="fs-frame" data-step={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <img src={f.light} alt={alt(f.label)} loading="lazy" class="theme-img-light" />
          <img src={f.dark} alt={alt(f.label)} loading="lazy" class="theme-img-dark" />
        </div>
      ))
    }
  </div>
  <div class="fs-controls" hidden>
    <button type="button" data-fs-prev aria-label="이전 단계">←</button>
    <span class="fs-count" data-fs-count>1 / {frames.length}</span>
    <button type="button" data-fs-next aria-label="다음 단계">→</button>
    <span class="fs-label" data-fs-label aria-live="polite">{labels[0]}</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  function initFigureSteps(): void {
    for (const fig of document.querySelectorAll<HTMLElement>('[data-figure-steps]')) {
      if (fig.dataset.ready) continue;
      fig.dataset.ready = 'true';
      const frames = [...fig.querySelectorAll<HTMLElement>('[data-step]')];
      const labels = JSON.parse(fig.dataset.labels ?? '[]') as string[];
      const controls = fig.querySelector<HTMLElement>('.fs-controls')!;
      const prev = fig.querySelector<HTMLButtonElement>('[data-fs-prev]')!;
      const next = fig.querySelector<HTMLButtonElement>('[data-fs-next]')!;
      const count = fig.querySelector<HTMLElement>('[data-fs-count]')!;
      const label = fig.querySelector<HTMLElement>('[data-fs-label]')!;
      let current = 0;

      const show = (i: number): void => {
        current = Math.max(0, Math.min(frames.length - 1, i));
        frames.forEach((f, j) => f.setAttribute('aria-hidden', String(j !== current)));
        count.textContent = `${current + 1} / ${frames.length}`;
        label.textContent = labels[current] ?? '';
        prev.disabled = current === 0;
        next.disabled = current === frames.length - 1;
      };

      prev.addEventListener('click', () => show(current - 1));
      next.addEventListener('click', () => show(current + 1));
      fig.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(current - 1);
        else if (e.key === 'ArrowRight') show(current + 1);
        else return;
        e.preventDefault();
      });
      // The other frames load lazily while hidden; load them now so stepping does not flicker.
      fig.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      controls.hidden = false;
      show(0);
    }
  }

  // DOMContentLoaded for initial load, astro:page-load for page transitions
  document.addEventListener('DOMContentLoaded', initFigureSteps);
  document.addEventListener('astro:page-load', initFigureSteps);
</script>

<style>
  .figure-steps {
    margin: 1.5rem 0;
    text-align: center;
  }

  /* Frames share one grid cell, so the stage keeps the size of the tallest frame. */
  .fs-stage {
    display: grid;
  }

  .fs-frame {
    grid-area: 1 / 1;
    transition: opacity 0.25s ease;
  }

  .fs-frame[aria-hidden='true'] {
    opacity: 0;
    visibility: hidden;
  }

  .fs-frame img {
    margin-inline: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-frame {
      transition: none;
    }
  }

  .theme-img-dark {
    display: none;
  }

  :global([data-theme='dark']) .theme-img-light {
    display: none;
  }

  :global([data-theme='dark']) .theme-img-dark {
    display: block;
  }

  .fs-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }

  .fs-controls[hidden] {
    display: none;
  }

  .fs-controls button {
    min-width: 2.25rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .fs-controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .fs-count {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .fs-label {
    flex-basis: 100%;
    color: var(--text);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
