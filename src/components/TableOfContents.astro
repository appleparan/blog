---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to h2-h4 (h1 is the article title)
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{tocHeadings.length > 0 && (
  <>
    <button
      class="toc-toggle"
      id="toc-toggle"
      type="button"
      aria-label="Table of contents"
      aria-expanded="false"
      aria-controls="toc-sidebar"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="4" cy="6" r="1"></circle>
        <line x1="9" y1="6" x2="20" y2="6"></line>
        <circle cx="4" cy="12" r="1"></circle>
        <line x1="9" y1="12" x2="20" y2="12"></line>
        <circle cx="4" cy="18" r="1"></circle>
        <line x1="9" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>
    <div class="toc-backdrop" id="toc-backdrop"></div>
    <nav class="toc-sidebar" id="toc-sidebar" aria-label="Table of Contents">
      <h2 class="toc-title" id="toc-heading">Contents</h2>
      <ul class="toc-list" aria-labelledby="toc-heading">
        {tocHeadings.map((heading) => (
          <li class={`toc-item toc-h${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </>
)}

<script>
  let currentObserver: IntersectionObserver | null = null;
  let currentKeydownHandler: ((e: KeyboardEvent) => void) | null = null;

  function closeTocSheet() {
    const nav = document.getElementById('toc-sidebar');
    const backdrop = document.getElementById('toc-backdrop');
    const toggle = document.getElementById('toc-toggle');
    nav?.classList.remove('toc-open');
    backdrop?.classList.remove('toc-open');
    document.body.classList.remove('toc-locked');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  function initTocSheet() {
    // Clean up previous keydown listener before re-registering
    if (currentKeydownHandler) {
      document.removeEventListener('keydown', currentKeydownHandler);
      currentKeydownHandler = null;
    }

    const toggle = document.getElementById('toc-toggle');
    const nav = document.getElementById('toc-sidebar');
    const backdrop = document.getElementById('toc-backdrop');
    if (!toggle || !nav || !backdrop) return;

    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('toc-open');
      backdrop.classList.toggle('toc-open', isOpen);
      document.body.classList.toggle('toc-locked', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    backdrop.addEventListener('click', closeTocSheet);

    currentKeydownHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeTocSheet();
    };
    document.addEventListener('keydown', currentKeydownHandler);
  }

  function initToc() {
    // Clean up previous observer and listeners
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }

    initTocSheet();

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-item a');
    if (tocLinks.length === 0) return;

    const headingElements: HTMLElement[] = [];
    tocLinks.forEach((link) => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) {
        const el = document.getElementById(id);
        if (el) headingElements.push(el);
      }
    });

    if (headingElements.length === 0) return;

    // Track all currently visible headings
    let activeId = '';
    const visibleHeadings = new Set<string>();

    currentObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            visibleHeadings.add(entry.target.id);
          } else {
            visibleHeadings.delete(entry.target.id);
          }
        });

        if (visibleHeadings.size > 0) {
          // Find the first visible heading in document order
          const firstVisible = headingElements.find((el) =>
            visibleHeadings.has(el.id),
          );
          if (firstVisible) activeId = firstVisible.id;
        } else {
          // Fallback: find the last heading above the viewport
          const scrollTop = window.scrollY + 100;
          let lastAbove = '';
          for (const el of headingElements) {
            const top = el.getBoundingClientRect().top + window.scrollY;
            if (top <= scrollTop) {
              lastAbove = el.id;
            }
          }
          if (lastAbove) activeId = lastAbove;
        }

        // Update active class
        tocLinks.forEach((link) => {
          const id = link.getAttribute('href')?.slice(1);
          const li = link.parentElement;
          if (li) {
            li.classList.toggle('toc-active', id === activeId);
          }
        });
      },
      {
        rootMargin: '-90px 0px -70% 0px',
        threshold: 0,
      },
    );

    headingElements.forEach((el) => currentObserver!.observe(el));

    // Smooth scroll on click
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;

        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${id}`);
        closeTocSheet();
      });
    });
  }

  // DOMContentLoaded for initial load, astro:page-load for page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initToc);
  } else {
    initToc();
  }
  document.addEventListener('astro:page-load', initToc);
</script>
