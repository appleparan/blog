---
// Share buttons: X, LinkedIn, and copy link.
interface Props {
  title: string;
  /** Absolute URL of the post. */
  url: string;
}

const { title, url } = Astro.props;
const xHref = `https://twitter.com/intent/tweet?${new URLSearchParams({ text: title, url })}`;
const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?${new URLSearchParams({ url })}`;
---

<div class="share">
  <span class="share-label">공유</span>
  <a href={xHref} target="_blank" rel="noopener noreferrer" aria-label="X에 공유">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
      ></path>
    </svg>
  </a>
  <a href={linkedinHref} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn에 공유">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
      ></path>
    </svg>
  </a>
  <button type="button" class="share-copy" data-url={url} aria-label="링크 복사">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <span class="share-copied" hidden>복사됨</span>
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.share-copy')) {
    button.addEventListener('click', async () => {
      const note = button.querySelector<HTMLElement>('.share-copied');
      try {
        await navigator.clipboard.writeText(button.dataset.url ?? location.href);
      } catch (error) {
        console.error('Copying the link failed', error);
        return;
      }
      if (!note) return;
      note.hidden = false;
      setTimeout(() => (note.hidden = true), 2000);
    });
  }
</script>

<style>
  .share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .share a,
  .share button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .share a:hover,
  .share button:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
