---
// Search index of published posts (getPosts() hides drafts in production).
import { getPosts } from '../lib/get-posts';
import { postUrl } from '../lib/posts';
import { excerpt } from '../lib/excerpt';
import { formatSeoulDate } from '../lib/format-date';

const searchData = (await getPosts()).map((post) => ({
  title: post.data.title,
  date: formatSeoulDate(post.data.date),
  url: postUrl(post),
  categories: post.data.categories,
  tags: post.data.tags,
  excerpt: post.data.description ?? excerpt(post.body ?? '', 300),
}));
// "<" is escaped so post text can never close the script element.
const searchJson = JSON.stringify(searchData).replace(/</g, '\\u003c');
---

<div class="search-overlay" id="search-overlay">
  <div class="search-modal">
    <div class="search-input-wrapper">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        class="search-input"
        id="search-input"
        placeholder="글 검색..."
        autocomplete="off"
      />
    </div>
    <div class="search-results" id="search-results"></div>
    <div class="search-hint">
      <span><kbd>Esc</kbd> 닫기</span>
      <span><kbd>⌘K</kbd> 검색</span>
    </div>
  </div>
</div>

<script type="application/json" id="search-data" set:html={searchJson} />

<script>
import Fuse from 'fuse.js';

type Item = {
  title: string;
  date: string;
  url: string;
  categories: string[];
  tags: string[];
  excerpt: string;
};

const overlay = document.getElementById('search-overlay') as HTMLElement;
const input = document.getElementById('search-input') as HTMLInputElement;
const results = document.getElementById('search-results') as HTMLElement;
const searchBtn = document.getElementById('search-btn');
const data: Item[] = JSON.parse(document.getElementById('search-data')?.textContent ?? '[]');

// Title counts most, then tags, categories, and the excerpt.
const fuse = new Fuse(data, {
  keys: [
    { name: 'title', weight: 4 },
    { name: 'tags', weight: 3 },
    { name: 'categories', weight: 2 },
    { name: 'excerpt', weight: 1 },
  ],
  threshold: 0.3,
  ignoreLocation: true,
  minMatchCharLength: 2,
});

function open() {
  overlay.classList.add('active');
  setTimeout(() => input.focus(), 50);
}

function close() {
  overlay.classList.remove('active');
  input.value = '';
  results.innerHTML = '';
}

function escapeHtml(str: string) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function renderResults(query: string) {
  if (!query.trim()) {
    results.innerHTML = '';
    return;
  }

  const matches = fuse.search(query.trim(), { limit: 20 }).map((r) => r.item);

  if (matches.length === 0) {
    results.innerHTML = '<div class="search-empty">검색 결과가 없습니다</div>';
    return;
  }

  results.innerHTML = matches
    .map(
      (item) =>
        '<a href="' + escapeHtml(item.url) + '" class="search-result-item">' +
        '<div class="search-result-title">' + escapeHtml(item.title) + '</div>' +
        '<div class="search-result-meta">' + escapeHtml(item.date) +
        (item.categories.length ? ' · ' + escapeHtml(item.categories.join(' / ')) : '') +
        '</div></a>',
    )
    .join('');
}

searchBtn?.addEventListener('click', open);

overlay.addEventListener('click', (e) => {
  if (e.target === overlay) close();
});

document.addEventListener('keydown', (e) => {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
    e.preventDefault();
    if (overlay.classList.contains('active')) close();
    else open();
  }
  if (e.key === 'Escape' && overlay.classList.contains('active')) close();
});

input.addEventListener('input', () => renderResults(input.value));
</script>
